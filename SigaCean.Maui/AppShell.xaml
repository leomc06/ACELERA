<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="SigaCean.AppShell"
       FlyoutBehavior="Locked"
       FlyoutBackgroundColor="White"
       Title="SIGA-CEAN">

    <Shell.FlyoutHeader>
        <Grid Padding="18,26,18,22" ColumnDefinitions="Auto,*" ColumnSpacing="10" BackgroundColor="White">
            <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 12" Padding="4" BackgroundColor="White" Stroke="{StaticResource Line}">
                <Image Source="cean_logo.png" Aspect="AspectFit" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="SIGA-CEAN" TextColor="{StaticResource Ink}" FontAttributes="Bold" FontSize="19" />
                <Label Text="Gestão de Estoque" TextColor="{StaticResource Muted}" FontSize="11" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid BackgroundColor="White">
            <Label Text="CEAN • Cruzeiro - SP" TextColor="{StaticResource Muted}" FontSize="11" Padding="18,12" />
        </Grid>
    </Shell.FlyoutFooter>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="18,4" HeightRequest="46">
                <Label Text="{Binding Title}" TextColor="{StaticResource Ink}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

</Shell>
