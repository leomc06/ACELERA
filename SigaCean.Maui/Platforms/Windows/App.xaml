<maui:MauiWinUIApplication
    x:Class="SigaCean.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:SigaCean.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- O ToggleSwitch do Windows reserva 154px de largura; sem isso o texto ao lado do Switch fica longe dele. -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
            <SolidColorBrush x:Key="NavigationViewButtonForeground" Color="White" />
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="NavigationViewButtonForegroundPressed" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewButtonBackgroundPointerOver" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewButtonBackgroundPressed" Color="#40FFFFFF" />
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
