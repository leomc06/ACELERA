<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SigaCean.Presentation.ViewModels"
             xmlns:views="clr-namespace:SigaCean.Presentation.Views"
             x:Class="SigaCean.Presentation.Views.EstoquePage"
             Title="Estoque">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18">

            <views:CabecalhoView x:Name="CabecalhoControl" />

            <views:AvisoBanner x:Name="AvisoBannerControl" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Estoque" Style="{StaticResource PageTitle}" />
                    <Label Text="Consulte a situação atual dos produtos." Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
                <FlexLayout x:Name="AcoesAdministrativoLayout" Grid.Column="1" JustifyContent="End" Wrap="Wrap" AlignItems="Start">
                    <Button Text="＋ Cadastrar produto" Style="{StaticResource PrimaryButton}" Clicked="OnNovoProdutoClicked" Margin="4" />
                    <Button Text="＋ Entrada" Style="{StaticResource GreenButton}" Clicked="OnEntradaClicked" Margin="4" />
                    <Button Text="− Saída" Style="{StaticResource OrangeButton}" Clicked="OnSaidaClicked" Margin="4" />
                    <Button Text="Ajuste de balanço" Clicked="OnAjusteClicked" Margin="4" />
                </FlexLayout>
            </Grid>

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Produtos em estoque" Style="{StaticResource CardTitle}" />
                    <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="Pesquisar por nome" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Categoria" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="Situação" Style="{StaticResource FieldLabel}" />
                        <Entry Grid.Row="1" Grid.Column="0" x:Name="PesquisaEntry" Placeholder="Digite o nome do produto..." TextChanged="OnPesquisaTextChanged" />
                        <Picker Grid.Row="1" Grid.Column="1" x:Name="CategoriaFiltroPicker" Title="Todas as categorias" SelectedIndexChanged="OnFiltroChanged" />
                        <Picker Grid.Row="1" Grid.Column="2" x:Name="SituacaoFiltroPicker" Title="Todas as situações" SelectedIndexChanged="OnFiltroChanged" />
                    </Grid>
                    <Label x:Name="ResultadoLabel" Style="{StaticResource MutedLabel}" />

                    <CollectionView x:Name="ProdutosCollectionView">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhum produto encontrado. Ajuste a pesquisa ou os filtros." Style="{StaticResource MutedLabel}" Padding="0,12" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProdutoEstoqueItem">
                                <Border Margin="0,4" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProdutoTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">

                                        <BoxView Grid.Column="0" Color="{Binding CorSaude}" WidthRequest="8" CornerRadius="4" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                            <Label Text="{Binding Categoria}" Style="{StaticResource MutedLabel}" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="SEM ESTOQUE" IsVisible="{Binding MostrarAlertaSemEstoque}" TextColor="{StaticResource Red}" FontSize="11" FontAttributes="Bold" />
                                                <Label Text="VENCIDO" IsVisible="{Binding MostrarAlertaVencido}" TextColor="{StaticResource Red}" FontSize="11" FontAttributes="Bold" />
                                                <Label Text="Validade próxima" IsVisible="{Binding MostrarAlertaValidadeProxima}" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
                                                <Label Text="Estoque crítico" IsVisible="{Binding MostrarAlertaCritico}" TextColor="{StaticResource Red}" FontSize="11" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                            <Label Text="{Binding QuantidadeAtual}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding EstoqueMinimoTexto, StringFormat='mínimo: {0}'}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding PercentualTexto}" FontSize="12" TextColor="{Binding CorSaude}" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
