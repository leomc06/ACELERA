<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SigaCean.Presentation.ViewModels"
             xmlns:views="clr-namespace:SigaCean.Presentation.Views"
             x:Class="SigaCean.Presentation.Views.MovimentacoesPage"
             Title="Movimentações">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18">

            <views:CabecalhoView x:Name="CabecalhoControl" />

            <views:AvisoBanner x:Name="AvisoBannerControl" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Movimentações" Style="{StaticResource PageTitle}" />
                <Label Text="Histórico de entradas, saídas e ajustes de balanço." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>

            <FlexLayout x:Name="AcoesAdministrativoLayout" JustifyContent="Start" Wrap="Wrap" AlignItems="Start" Margin="-4,-8,0,0">
                <Button Text="＋ Entrada" Style="{StaticResource GreenButton}" Clicked="OnEntradaClicked" Margin="4" />
                <Button Text="− Saída" Style="{StaticResource OrangeButton}" Clicked="OnSaidaClicked" Margin="4" />
            </FlexLayout>

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Histórico" Style="{StaticResource CardTitle}" />
                    <Entry x:Name="PesquisaEntry" Placeholder="Pesquisar por produto, retirante, destino ou documento..." SemanticProperties.Description="Pesquisar no histórico" TextChanged="OnPesquisaTextChanged" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="Tipo" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Situação" Style="{StaticResource FieldLabel}" />
                        <Picker Grid.Row="1" Grid.Column="0" x:Name="TipoFiltroPicker" Title="Todos os tipos" SelectedIndexChanged="OnFiltroChanged" />
                        <Picker Grid.Row="1" Grid.Column="1" x:Name="StatusFiltroPicker" Title="Todas as situações" SelectedIndexChanged="OnFiltroChanged" />
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Filtrar por período" VerticalOptions="Center" />
                        <Switch x:Name="FiltrarPeriodoSwitch" Toggled="OnFiltrarPeriodoToggled" SemanticProperties.Description="Filtrar por período" />
                    </HorizontalStackLayout>
                    <Grid x:Name="PeriodoLayout" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0" Grid.Column="0" Text="De" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Até" Style="{StaticResource FieldLabel}" />
                        <DatePicker Grid.Row="1" Grid.Column="0" x:Name="DataInicioPicker" DateSelected="OnPeriodoChanged" />
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DataFimPicker" DateSelected="OnPeriodoChanged" />
                    </Grid>

                    <Label x:Name="MensagemLabel" TextColor="{StaticResource Red}" IsVisible="False" />
                    <Label x:Name="ResultadoLabel" Style="{StaticResource MutedLabel}" />

                    <CollectionView x:Name="MovimentacoesCollectionView">
                        <CollectionView.EmptyView>
                            <Label Text="Nenhuma movimentação encontrada." Style="{StaticResource MutedLabel}" Padding="0,12" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MovimentacaoHistoricoItem">
                                <Border Margin="0,4" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMovimentacaoTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">

                                        <BoxView Grid.Column="0" Color="{Binding CorTipo}" WidthRequest="8" CornerRadius="4" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding TipoTexto}" FontAttributes="Bold" TextColor="{Binding CorTipo}" />
                                                <Label Text="{Binding ProdutoNome}" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding DetalheTexto}" Style="{StaticResource MutedLabel}" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding DataFormatada}" FontSize="12" TextColor="{StaticResource Muted}" />
                                                <Label Text="{Binding UsuarioTexto, StringFormat='resp.: {0}'}" FontSize="12" TextColor="{StaticResource Muted}" />
                                                <Label Text="{Binding StatusTexto}" FontSize="12" TextColor="{StaticResource Red}" FontAttributes="Bold" IsVisible="{Binding MostrarStatusEspecial}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding QuantidadeTexto}" FontAttributes="Bold" TextColor="{Binding CorTipo}" VerticalOptions="Center" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button x:Name="MostrarMaisButton" Text="Mostrar mais" Clicked="OnMostrarMaisClicked" IsVisible="False" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
