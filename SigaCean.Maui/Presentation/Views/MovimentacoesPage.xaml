<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SigaCean.Presentation.ViewModels"
             x:Class="SigaCean.Presentation.Views.MovimentacoesPage"
             Title="Movimentações">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="CEAN • CENTRO DE APOIO AOS ANIMAIS" Style="{StaticResource EyebrowLabel}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="9" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Padding="0" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
                        <Label x:Name="UsuarioInicialLabel" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0">
                        <Label x:Name="UsuarioNomeLabel" FontSize="12" />
                        <Label x:Name="UsuarioPerfilLabel" Style="{StaticResource MutedLabel}" FontSize="10" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Movimentações" Style="{StaticResource PageTitle}" />
                    <Label Text="Histórico de entradas e saídas." Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>
                <FlexLayout x:Name="AcoesAdministrativoLayout" Grid.Column="1" JustifyContent="End" Wrap="Wrap" AlignItems="Start">
                    <Button Text="＋ Entrada" Style="{StaticResource GreenButton}" Clicked="OnEntradaClicked" Margin="4" />
                    <Button Text="− Saída" Style="{StaticResource OrangeButton}" Clicked="OnSaidaClicked" Margin="4" />
                </FlexLayout>
            </Grid>

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Histórico" Style="{StaticResource CardTitle}" />
                    <Entry x:Name="PesquisaEntry" Placeholder="Pesquisar por produto, retirante, destino ou documento..." TextChanged="OnPesquisaTextChanged" />

                    <CollectionView x:Name="MovimentacoesCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MovimentacaoHistoricoItem">
                                <Border Margin="0,4" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMovimentacaoTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">

                                        <BoxView Grid.Column="0" Color="{Binding CorTipo}" WidthRequest="8" CornerRadius="4" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding TipoTexto}" FontAttributes="Bold" TextColor="{Binding CorTipo}" />
                                                <Label Text="{Binding ProdutoNome}" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding DetalheTexto}" Style="{StaticResource MutedLabel}" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding DataFormatada}" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label Text="{Binding UsuarioTexto, StringFormat='resp.: {0}'}" FontSize="11" TextColor="{StaticResource Muted}" />
                                                <Label Text="{Binding StatusTexto}" FontSize="11" TextColor="{StaticResource Red}" FontAttributes="Bold" IsVisible="{Binding MostrarStatusEspecial}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding QuantidadeTexto}" FontAttributes="Bold" TextColor="{Binding CorTipo}" VerticalOptions="Center" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
