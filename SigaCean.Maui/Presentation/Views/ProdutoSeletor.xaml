<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SigaCean.Presentation.Views.ProdutoSeletor">

    <VerticalStackLayout Spacing="4">

        <!-- Campo unico: digita-se para buscar e o produto escolhido fica escrito aqui (mesma altura dos demais campos). -->
        <Border HeightRequest="44" Padding="0" StrokeShape="RoundRectangle 8" BackgroundColor="#E6F2F1" Stroke="#B5D3D0">
            <Entry x:Name="BuscaEntry" Placeholder="Digite para buscar o produto..." MinimumHeightRequest="0" VerticalOptions="Center"
                   TextChanged="OnBuscaChanged" Focused="OnBuscaFocused" Unfocused="OnBuscaUnfocused" />
        </Border>

        <!-- Resultados: aparecem sozinhos enquanto se digita. -->
        <Border x:Name="ListaBorder" IsVisible="False" Padding="0" StrokeShape="RoundRectangle 8">
            <ScrollView MaximumHeightRequest="230">
                <VerticalStackLayout x:Name="ListaLayout" />
            </ScrollView>
        </Border>

        <Label x:Name="ResumoLabel" Style="{StaticResource MutedLabel}" />
    </VerticalStackLayout>

</ContentView>
